oracle-venv/
*-oracle-venv/

# Local fixture overrides (see fixtures.py)
fixtures.local.json

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Ephemeris data files, if ever added via SE_EPHE_PATH (large binaries)
*.se1
*.se2

# Runtime output from the "Ask about this chart" thumbs-down feedback.
